{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Justice Client",
  "version": "0.7.6",
  "identifier": "cz.justice.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Justice Client",
        "width": 1180,
        "height": 720,
        "minWidth": 480,
        "minHeight": 520,
        "decorations": false,
        "center": true,
        "backgroundColor": "#08080a"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "category": "Game",
    "shortDescription": "Minecraft launcher for recording and PvP",
    "linux": {
      "deb": {
        "depends": [
          "libgl1",
          "libx11-6",
          "libxcursor1",
          "libxrandr2",
          "libxi6",
          "libasound2",
          "x11-xserver-utils",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-libav"
        ]
      }
    },
    "createUpdaterArtifacts": true,
    "resources": [
      "resources/justice-mod-*.jar"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUyQTdBQTRDQTBGRThBOUIKUldTYml2NmdUS3FuVWlJWThURHVaY2pGNnZ6b0FseUhmSnBFRHgxajVTZUsvZVU2cnZjN2M5eUUK",
      "endpoints": [
        "https://justiceclient.online/latest.json",
        "https://ertenix.net/justice/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
